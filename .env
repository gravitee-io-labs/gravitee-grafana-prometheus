# Compose project name, keeps containers/volumes separate from other Gravitee stacks
COMPOSE_PROJECT_NAME=gravitee-prom

# Image versions
APIM_VERSION=4.13
MONGO_VERSION=6
ELASTIC_VERSION=8.11.3
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.2.0
HTTPBIN_VERSION=v2.15.0
PYTHON_VERSION=3.12-alpine

# Demo traffic generator (docker compose --profile demo up -d)
TRAFFIC_RPS=15

# Host ports (remapped so this stack can run next to another local Gravitee stack on the default ports)
GATEWAY_PORT=28082
MGMT_API_PORT=28083
MGMT_UI_PORT=28084
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Gateway internal API (serves /_node/metrics/prometheus). Change before exposing anywhere.
GATEWAY_INTERNAL_USER=admin
GATEWAY_INTERNAL_PASSWORD=adminadmin

# Grafana admin
GRAFANA_ADMIN_PASSWORD=admin
