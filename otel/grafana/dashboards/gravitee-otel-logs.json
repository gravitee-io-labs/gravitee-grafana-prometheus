{
  "uid": "gravitee-otel-logs",
  "title": "Gravitee OTel \u00b7 Call Logs",
  "description": "Payloads of logged API calls, from the Gateway's OpenTelemetry logs in Loki: search them, list failed calls, and inspect one call hop by hop.",
  "tags": [
    "gravitee-otel"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Gravitee dashboards",
      "type": "dashboards",
      "tags": [
        "gravitee-otel"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "label": "Metrics (Prometheus)",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "current": {
          "text": "prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "ds_loki",
        "label": "Call logs (Loki)",
        "type": "datasource",
        "query": "loki",
        "regex": "",
        "current": {
          "text": "gravitee-loki",
          "value": "gravitee-loki"
        },
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "ds_tempo",
        "label": "Traces (Tempo)",
        "type": "datasource",
        "query": "tempo",
        "regex": "",
        "current": {
          "text": "gravitee-tempo",
          "value": "gravitee-tempo"
        },
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "api",
        "label": "API",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(gravitee_calls_total{span_kind=\"SPAN_KIND_SERVER\"}, gravitee_api_name)",
          "refId": "api"
        },
        "definition": "label_values(gravitee_calls_total{span_kind=\"SPAN_KIND_SERVER\"}, gravitee_api_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "request_id",
        "label": "Request id (call detail)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "search",
        "label": "Search payloads (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "\n**Call logs** here are the Gateway's **OpenTelemetry logs**: the request and response **payloads** of each logged call,\non the client side and the backend side, linked to the call's trace. They're written for APIs with **OTel logs enabled**\n(API \u2192 *Reporter settings*), for the calls that match the API's logging condition: the demo logs **1 call in 5**.\nHeaders are not exported as OTel logs: open the trace for the call's path through the Gateway.\n**Search** filters payloads with a regular expression, e.g. `EUR` or `wayne`. \u26a0\ufe0f Payloads can contain personal data:\nrestrict access to the Loki data source.\n"
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Logged calls",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Logged calls",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({service_name=\"gio-apim-gateway\"} | gravitee_api_name=~\"$api\" | gravitee_log_type=\"entrypoint-response\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1f60c4",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true
      },
      "transformations": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Share of calls logged",
      "description": "Logged calls (Loki) / all calls (span metrics). Logging conditions and APIs without OTel logs keep this below 100 %.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({service_name=\"gio-apim-gateway\"} | gravitee_api_name=~\"$api\" | gravitee_log_type=\"entrypoint-response\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "hide": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(increase(gravitee_calls_total{span_kind=\"SPAN_KIND_SERVER\", gravitee_api_name=~\"$api\"}[$__range]))",
          "legendFormat": "",
          "hide": true,
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "A",
          "reducer": "sum",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "B",
          "reducer": "sum",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$C / $D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true
      },
      "transformations": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Logged failures (4xx/5xx)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 4
