          "expr": "sum(count_over_time({service_name=\"gio-apim-gateway\"} | gravitee_api_name=~\"$api\" | gravitee_log_type=\"endpoint-response\" | http_response_status_code = 0 [$__range]))",
          "legendFormat": "",
