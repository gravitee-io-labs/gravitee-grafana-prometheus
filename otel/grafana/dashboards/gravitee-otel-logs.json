    {
      "id": 12,
      "type": "table",
      "title": "Logged failed calls",
      "description": "Click a request id to show its payloads below, or a trace to open its spans.",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{service_name=\"gio-apim-gateway\"} | gravitee_api_name=~\"$api\" | gravitee_log_type=\"entrypoint-response\" | http_response_status_code >= 400",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Request id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show this call's payloads",
                    "url": "/d/gravitee-otel-logs?${__url_time_range}&${ds_prom:queryparam}&${ds_loki:queryparam}&${ds_tempo:queryparam}&var-request_id=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the trace",
                    "url": "/explore?schemaVersion=1&orgId=1&panes={\"t\":{\"datasource\":\"${ds_tempo}\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"${ds_tempo}\"},\"queryType\":\"traceql\",\"query\":\"${__value.raw}\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 400
                    },
                    {
                      "color": "red",
                      "value": 500
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Response body"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "http_response_status_code",
                "destinationType": "number"
              }
            ]
          }
