          },
          "expr": "sum(count_over_time({service_name=\"gio-apim-gateway\"} | gravitee_api_name=~\"$api\" | gravitee_log_type=\"entrypoint-response\" | http_response_status_code >= 500 | http_response_status_code < 600 [$__auto]))",
