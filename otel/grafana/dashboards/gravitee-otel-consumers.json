      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 14,
        "y": 23,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (flow) (rate(gravitee_calls_total{gravitee_api_name=~\"$api\", span_kind=\"SPAN_KIND_INTERNAL\", gravitee_execution_phase=\"request\", flow=~\"plan-.*\"}[$__rate_interval]))",
          "legendFormat": "{{flow}}",
          "hide": false,
          "range": true
