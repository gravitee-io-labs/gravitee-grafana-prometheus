    {
      "id": 10,
      "type": "row",
      "title": "Per-API SLO compliance",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Per-API SLIs",
      "description": "Calls and P95 over the selected range; the other columns from the recording rules. A burn rate above 1 consumes the error budget faster than allowed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (gravitee_api_name) (increase(gravitee_calls_total{span_kind=\"SPAN_KIND_SERVER\", gravitee_api_name=~\"$api\"}[$__range]))",
          "legendFormat": "",
          "hide": false,
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (gravitee_api_name) (gravitee_api:sli_availability:ratio_rate30d{gravitee_api_name=~\"$api\"})",
          "legendFormat": "",
          "hide": false,
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (gravitee_api_name) (gravitee_api:error_budget_remaining:ratio30d{gravitee_api_name=~\"$api\"})",
          "legendFormat": "",
          "hide": false,
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (gravitee_api_name) (gravitee_api:error_burn_rate:1h{gravitee_api_name=~\"$api\"})",
          "legendFormat": "",
          "hide": false,
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (gravitee_api_name) (gravitee_api:sli_latency:ratio_rate30d{gravitee_api_name=~\"$api\"})",
          "legendFormat": "",
          "hide": false,
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, gravitee_api_name) (rate(gravitee_duration_milliseconds_bucket{span_kind=\"SPAN_KIND_SERVER\", gravitee_api_name=~\"$api\"}[$__range])))",
          "legendFormat": "",
          "hide": false,
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          },
          "mappings": []
        },
        "overrides": [
