# Compose project name: containers and volumes are separate from the Elasticsearch stack (gravitee-prom)
COMPOSE_PROJECT_NAME=gravitee-otel

# Image versions
APIM_VERSION=4.13
MONGO_VERSION=6
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.2.0
OTELCOL_VERSION=0.115.1
TEMPO_VERSION=2.7.2
LOKI_VERSION=3.3.2
HTTPBIN_VERSION=v2.15.0
PYTHON_VERSION=3.12-alpine

# Demo traffic generator (docker compose --profile demo up -d)
TRAFFIC_RPS=15

# Host ports (different from the Elasticsearch stack, so both can run side by side)
GATEWAY_PORT=38082
MGMT_API_PORT=38083
MGMT_UI_PORT=38084
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001

# Gateway internal API (serves /_node/metrics/prometheus). Change before exposing anywhere.
GATEWAY_INTERNAL_USER=admin
GATEWAY_INTERNAL_PASSWORD=adminadmin

# Grafana admin
GRAFANA_ADMIN_PASSWORD=admin
