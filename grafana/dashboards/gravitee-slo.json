        {
          "refId": "C",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "A",
          "reducer": "sum",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "B",
          "reducer": "sum",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          },
          "hide": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$C / $D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
