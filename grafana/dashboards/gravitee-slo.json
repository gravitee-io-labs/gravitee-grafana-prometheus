            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "Availability",
            "binary": {
              "left": "1",
              "operator": "-",
              "right": "Errors %"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "Slow %",
            "binary": {
              "left": "Slow (>500ms)",
              "operator": "/",
              "right": "Calls"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "Error budget used",
            "binary": {
              "left": "Errors %",
              "operator": "/",
              "right": "0.005"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {},
            "excludeByName": {
              "Errors %": true
            },
