{
  "uid": "gravitee-slo",
  "title": "Gravitee \u00b7 SLOs & Error Budgets",
  "description": "Availability and latency objectives with multi-window burn-rate alerting (Prometheus) and per-API SLO compliance (analytics).",
  "tags": [
    "gravitee"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Gravitee dashboards",
      "type": "dashboards",
      "tags": [
        "gravitee"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_analytics",
        "label": "Analytics (Elasticsearch)",
        "type": "datasource",
        "query": "elasticsearch",
        "regex": "",
        "current": {
          "text": "gravitee-analytics",
          "value": "gravitee-analytics"
        },
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "ds_prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "current": {
          "text": "prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "api",
        "label": "API",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "${ds_analytics}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"api-name\", \"query\": \"*\", \"size\": 500}",
        "definition": "terms api-name",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": "*",
