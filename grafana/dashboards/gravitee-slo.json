          "options": {
            "renameByName": {
              "api-name": "API",
              "Count": "Calls",
              "Count 1": "Calls",
              "p95.0 gateway-response-time-ms": "P95 ms",
              "p99.0 gateway-response-time-ms": "P99 ms",
              "Count 2": "5xx",
              "Count 3": "Slow (>500ms)"
            },
            "excludeByName": {},
            "indexByName": {}
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "Errors %",
