              "API": 0,
              "Calls": 1,
              "Availability": 2,
              "Error budget used": 3,
              "5xx": 4,
              "P95 ms": 5,
              "P99 ms": 6,
              "Slow %": 7,
              "Slow (>500ms)": 8
            }
          }
        }
      ]
