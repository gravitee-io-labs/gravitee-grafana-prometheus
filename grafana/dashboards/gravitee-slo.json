        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true
      },
      "transformations": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Latency SLI: calls \u2264 500 ms",
      "description": "Share of calls answered within 500 ms over the selected range (exact, from analytics).",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${ds_analytics}"
          },
          "query": "api-name:$api AND gateway-response-time-ms:<=500",
          "alias": "",
          "hide": true,
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${ds_analytics}"
          },
          "query": "api-name:$api",
          "alias": "",
          "hide": true,
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
